generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Profile {
  id              Int      @id @default(autoincrement())
  discordUserId   String   @unique
  name            String?
  currentEmployer String?
  currentRole     String?
  longTermGoals   String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

enum AreaSlug {
  work
  business
  content
  health
  personal
  study
}

model Area {
  id            Int            @id @default(autoincrement())
  slug          AreaSlug       @unique
  name          String
  description   String?
  emoji         String?
  color         String?
  createdAt     DateTime       @default(now())

  projects      Project[]
  goals         Goal[]
  weeklyTargets WeeklyTarget[]
}

model Event {
  id             Int       @id @default(autoincrement())
  title          String
  description    String?
  datetime       DateTime
  location       String?
  contactPerson  String?
  isAllDay       Boolean   @default(false)
  isRecurring    Boolean   @default(false)
  recurringRule  String?
  reminded       Boolean   @default(false)
  status         String    @default("pending")
  createdAt      DateTime  @default(now())

  @@index([datetime])
  @@index([status])
}

model Goal {
  id           Int          @id @default(autoincrement())
  title        String
  description  String?
  targetValue  Float?
  currentValue Float        @default(0)
  unit         String?
  deadline     DateTime?
  areaSlug     AreaSlug?
  area         Area?        @relation(fields: [areaSlug], references: [slug])
  status       String       @default("active")
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  entries      GoalEntry[]

  @@index([status])
  @@index([areaSlug])
}

model GoalEntry {
  id        Int      @id @default(autoincrement())
  goalId    Int
  value     Float
  note      String?
  createdAt DateTime @default(now())
  goal      Goal     @relation(fields: [goalId], references: [id], onDelete: Cascade)

  @@index([goalId])
}

model Project {
  id              Int      @id @default(autoincrement())
  name            String
  description     String?
  areaSlug        AreaSlug?
  area            Area?     @relation(fields: [areaSlug], references: [slug])
  githubRepo      String?
  githubOwner     String?
  githubRepoName  String?
  priority        Int      @default(3)
  status          String   @default("active")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([status])
  @@index([areaSlug])
}

model ContextLog {
  id          Int       @id @default(autoincrement())
  description String
  startDate   DateTime
  endDate     DateTime?
  impact      String?
  active      Boolean   @default(true)
  createdAt   DateTime  @default(now())

  @@index([active])
}

model WeeklyTarget {
  id          Int           @id @default(autoincrement())
  areaSlug    AreaSlug
  area        Area          @relation(fields: [areaSlug], references: [slug])
  activity    String
  targetCount Int
  active      Boolean       @default(true)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  entries     WeeklyEntry[]

  @@index([areaSlug])
  @@index([active])
}

model WeeklyEntry {
  id              Int          @id @default(autoincrement())
  weeklyTargetId  Int
  weeklyTarget    WeeklyTarget @relation(fields: [weeklyTargetId], references: [id], onDelete: Cascade)
  weekStart       DateTime
  completedCount  Int          @default(0)
  notes           String?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  @@unique([weeklyTargetId, weekStart])
  @@index([weekStart])
}


